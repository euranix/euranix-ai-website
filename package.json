{
  "name": "euranix-ai-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .build/server && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:release": "node scripts/release-check.cjs",
    "test:enquiries": "node scripts/enquiry-check.cjs",
    "lint": "eslint src",
    "test:adapter": "node scripts/enquiry-adapter-check.cjs",
    "test:preservation": "node scripts/preservation-check.cjs",
    "test:container": "node scripts/container-check.cjs",
    "test:performance": "node scripts/release-performance.cjs"
  },
  "type": "module"
}
